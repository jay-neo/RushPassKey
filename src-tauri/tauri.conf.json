{
  "productName": "RushPassKey",
  "version": "1.0.1",
  "identifier": "com.rushpasskey.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "RushPassKey",
        "minWidth": 440,
        "minHeight": 800,
        "width": 1200,
        "height": 800
      }
    ],
    "security": {
      "csp": null,
      "capabilities": [
        {
          "identifier": "allow-write-text",
          "description": "My application capability used for all windows",
          "windows": ["*"],
          "permissions": ["clipboard-manager:allow-write-text"]
        }
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
